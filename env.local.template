# Rename this file to .env.local (stays gitignored), then fill the values.

# Notion blog (Writing page). Share the database with the integration in Notion.
NOTION_API_KEY=
NOTION_DATABASE_ID=
# optional: auto-resolved from the database when left empty
NOTION_DATA_SOURCE_ID=

# Resend contact form (/work). FROM must be on a Resend-verified domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Photography (home carousel). Public base URL of the R2 bucket (r2.dev subdomain
# or custom domain) — the app fetches ${PHOTOS_BASE_URL}/manifest.json. Empty →
# bundled sample frames render instead.
PHOTOS_BASE_URL=
# R2 write credentials — only `npm run photos:sync` uses these (see the header of
# scripts/photos-sync.mjs for the one-time bucket setup).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
